# ── Database ─────────────────────────────────────────
DATABASE_URL=mssql+pyodbc://<username>:<password>@<server>.database.windows.net:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server

# ── JWT Authentication ───────────────────────────────
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Claude AI ────────────────────────────────────────
#ANTHROPIC_API_KEY=your-claude-api-key-here

# ── Storage backend switch ───────────────────────────
STORAGE_BACKEND=local
# local | azure

# ── Azure Blob Storage (only needed when STORAGE_BACKEND=azure) ──
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=resumes


GEMINI_API_KEY=your-gemini-api-key-here
